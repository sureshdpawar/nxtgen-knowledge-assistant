# ============================================================
# NXTGEN Knowledge Assistant
# Production / Docker Environment
# ============================================================


# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

ENVIRONMENT=production


# ------------------------------------------------------------
# PostgreSQL Container
# ------------------------------------------------------------

POSTGRES_DB=nxtgen
POSTGRES_USER=nxtgen
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD


# ------------------------------------------------------------
# Backend Database Connection
#
# "postgres" is the Docker Compose service name.
# Do NOT use localhost here.
# ------------------------------------------------------------

DATABASE_URL=postgresql://nxtgen:CHANGE_ME_STRONG_DATABASE_PASSWORD@postgres:5432/nxtgen


# ------------------------------------------------------------
# Authentication
#
# Must match Settings.SECRET_KEY
# ------------------------------------------------------------

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------------------------------------
# Legacy / Default LLM Configuration
#
# These are required by the current Settings class.
#
# If you are using OpenAI-compatible APIs:
# ------------------------------------------------------------

LLM_API=https://api.openai.com/v1

LLM_API_KEY=CHANGE_ME_LLM_API_KEY


# ------------------------------------------------------------
# CORS
#
# For local production-style Docker testing.
#
# When we deploy to Lightsail this will change to the
# actual HTTPS frontend/domain.
# ------------------------------------------------------------

CORS_ORIGINS=http://localhost:3000


# ------------------------------------------------------------
# Document Storage
#
# Both the backend and background worker mount the same
# Docker storage volume at /app/storage.
# ------------------------------------------------------------

STORAGE_PATH=/app/storage

DOCUMENT_STORAGE_PATH=/app/storage


# ------------------------------------------------------------
# Document Processing
# ------------------------------------------------------------

CHUNK_SIZE=1000

CHUNK_OVERLAP=200


# ------------------------------------------------------------
# Background Document Ingestion
#
# Source synchronization itself remains manually triggered
# for the MVP.
#
# Once a Document is created, the background worker claims
# its DocumentIngestionJob and performs parsing, chunking,
# and embedding asynchronously.
# ------------------------------------------------------------

# How often the worker checks PostgreSQL for pending jobs.
INGESTION_WORKER_POLL_SECONDS=2

# A PROCESSING job older than this can be recovered when
# the worker starts.
#
# 3600 seconds = 1 hour.
INGESTION_JOB_STALE_AFTER_SECONDS=3600

# Maximum number of times a job may be claimed/recovered
# before it is permanently marked FAILED.
INGESTION_JOB_MAX_ATTEMPTS=3


# ------------------------------------------------------------
# Search
# ------------------------------------------------------------

TOP_K=5


# ------------------------------------------------------------
# Docker Published Ports
#
# These are consumed by Docker Compose, not FastAPI Settings.
# ------------------------------------------------------------

BACKEND_PORT=8000

FRONTEND_PORT=3000

MCP_PORT=9000

MOCK_REST_PORT=9100


# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1